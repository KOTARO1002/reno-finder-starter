{
  "name": "reno-finder-starter",
  "version": "1.0.0",
  "private": true,
  "description": "中古×リノベ 資金計画シミュレーター（静的サイト）",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/app.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./assets/app.css --watch",
    "start": "npx --yes serve .",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
